                 f"Duplicate solve for user {user.id} on challenge {challenge.id}"
             ) from e
 
+        # Auto First Blood / Top 3 Bonus
+        try:
+            solve_count = Solves.query.filter_by(challenge_id=challenge.id).count()
+            bonus_val = 0
+            bonus_name = ""
+            if solve_count == 1:
+                bonus_val = 50
+                bonus_name = f"🥇 一血首殺 (+50) - {challenge.name}"
+            elif solve_count == 2:
+                bonus_val = 30
+                bonus_name = f"🥈 二血先鋒 (+30) - {challenge.name}"
+            elif solve_count == 3:
+                bonus_val = 10
+                bonus_name = f"🥉 三血新星 (+10) - {challenge.name}"
+            
+            if bonus_val > 0:
+                award = Awards(
+                    user_id=user.id,
+                    team_id=team.id if team else None,
+                    name=bonus_name,
+                    description=f"恭喜以第 {solve_count} 名解出「{challenge.name}」獲得額外加分！",
+                    value=bonus_val,
+                    category="bonus",
+                    icon="fas fa-medal",
+                    type="standard"
+                )
+                db.session.add(award)
+                db.session.commit()
+        except Exception as err:
+            db.session.rollback()
+            print(f"[ERROR] Award hook failed: {err}")
+
         # If the challenge is dynamic we should calculate a new value
         if challenge.function in DECAY_FUNCTIONS:
             calculate_value(challenge)
